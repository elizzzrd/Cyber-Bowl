+
+            if (!slot.enabled || slot.hour != date.hour() ||
+                slot.minute != date.minute() ||
+                candidate.lastRunDay[i] == today)
+                continue;
+
+            candidate.lastRunDay[i] = today;
+            event.changed = true;
+            if (event.due)
+                event.collision = true;
+            else {
